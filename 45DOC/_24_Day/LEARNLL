🔧 **Test Case Template:**
```java
public class LinkedListTester {
    public static void main(String[] args) {
        LinkedList list = new LinkedList();
        
        // Test basic operations
        testBasicOperations(list);
        
        // Test edge cases
        testEdgeCases(list);
        
        // Test advanced operations
        testAdvancedOperations(list);
    }
    
    private static void testBasicOperations(LinkedList list) {
        System.out.println("=== Testing Basic Operations ===");
        
        // Test append
        list.append(1);
        list.append(2);
        list.append(3);
        list.display(); // Expected: 1 -> 2 -> 3 -> null
        
        // Test prepend
        list.prepend(0);
        list.display(); // Expected: 0 -> 1 -> 2 -> 3 -> null
        
        // Add more tests...
    }
    
    private static void testEdgeCases(LinkedList list) {
        System.out.println("=== Testing Edge Cases ===");
        
        LinkedList emptyList = new LinkedList();
        
        // Test operations on empty list
        emptyList.display(); // Expected: null
        System.out.println("Size: " + emptyList.size()); // Expected: 0
        
        // Test single element
        emptyList.append(42);
        emptyList.display(); // Expected: 42 -> null
        
        // Add more edge case tests...
    }
}
```

