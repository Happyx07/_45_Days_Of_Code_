public class LinkedList {
    private ListNode head;
    
    public LinkedList() {
        this.head = null;
    }
    
    // Display method template
    public void display() {
        ListNode current = head;
        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }
        System.out.println("null");
    }
    
