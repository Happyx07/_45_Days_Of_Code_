    // ==================== SOLUTION 3: RAT IN A MAZE ====================
    
    /**
     * Find all paths from (0,0) to (n-1,n-1) in maze
     * Time: O(4^(N²)) in worst case (all cells open)
     * Space: O(N²) for visited array + O(N²) for recursion
     */
    public static List<String> ratInMaze(int[][] maze, int n) {
        List<String> paths = new ArrayList<>();
        
        // Edge cases
        if (maze == null || n == 0 || maze[0][0] == 0 || maze[n-1][n-1] == 0) {
            return paths;
        }
        
        boolean[][] visited = new boolean[n][n];
        findPaths(maze, n, 0, 0, "", paths, visited);
        
        return paths;
    }
    
    /**
     * Recursive backtracking function to explore all paths
     */
    private static void findPaths(int[][] maze, int n, int row, int col, 
                                  String path, List<String> paths, 
                                  boolean[][] visited) {
        
        // BASE CASE: Reached destination!
        if (row == n - 1 && col == n - 1) {
            paths.add(path);
            return;
        }
        
        // STEP 1: Mark current cell as visited
        visited[row][col] = true;
        
        // STEP 2: Try all 4 directions in lexicographic order (D, L, R, U)
        
        // Try Down
        if (isValid(maze, n, row + 1, col, visited)) {
            findPaths(maze, n, row + 1, col, path + "D", paths, visited);
        }
        
        // Try Left
        if (isValid(maze, n, row, col - 1, visited)) {
            findPaths(maze, n, row, col - 1, path + "L", paths, visited);
        }
        
        // Try Right
        if (isValid(maze, n, row, col + 1, visited)) {
            findPaths(maze, n, row, col + 1, path + "R", paths, visited);
        }
        
        // Try Up
        if (isValid(maze, n, row - 1, col, visited)) {
            findPaths(maze, n, row - 1, col, path + "U", paths, visited);
        }
        
        // STEP 3: BACKTRACK - Unmark cell so other paths can use it
        visited[row][col] = false;
    }
    
    /**
     * Check if a move to (row, col) is valid
     */
    private static boolean isValid(int[][] maze, int n, int row, int col, 
                                   boolean[][] visited) {
        return row >= 0 && row < n && 
               col >= 0 && col < n && 
               maze[row][col] == 1 && 
               !visited[row][col];
    }
    
    /**
     * CLEANER VERSION using direction arrays
     * This is the RECOMMENDED approach for production code
     */
    public static List<String> ratInMazeClean(int[][] maze, int n) {
        List<String> paths = new ArrayList<>();
        if (maze == null || n == 0 || maze[0][0] == 0 || maze[n-1][n-1] == 0) {
            return paths;
        }
        
        boolean[][] visited = new boolean[n][n];
        findPathsClean(maze, n, 0, 0, "", paths, visited);
        return paths;
    }
    
    private static void findPathsClean(int[][] maze, int n, int row, int col,
                                      String path, List<String> paths,
                                      boolean[][] visited) {
        // Reached destination
        if (row == n - 1 && col == n - 1) {
            paths.add(path);
            return;
        }
        
        // Mark visited
        visited[row][col] = true;
        
        // Direction arrays for D, L, R, U
        int[] dRow = {1, 0, 0, -1};
        int[] dCol = {0, -1, 1, 0};
        char[] dirChar = {'D', 'L', 'R', 'U'};
        
        // Try all 4 directions
        for (int i = 0; i < 4; i++) {
            int newRow = row + dRow[i];
            int newCol = col + dCol[i];
            
            if (isValid(maze, n, newRow, newCol, visited)) {
                findPathsClean(maze, n, newRow, newCol, 
                             path + dirChar[i], paths, visited);
            }
        }
        
        // Backtrack
        visited[row][col] = false;
    }
    
    /*
    ───────────────────────────────────────────────────────────────────────
    
    📈 COMPLEXITY ANALYSIS - RAT IN A MAZE:
    
    Time Complexity: O(4^(N²))
    - In worst case (all cells open), from each cell we try 4 directions
    - We might visit up to N² cells
    - So theoretically 4^(N²) paths possible
    - In practice, much better due to walls and visited marking
    
    Space Complexity: O(N²)
    - Visited array: O(N²)
    - Recursion stack: O(N²) in worst case (path length)
    - Path string: O(N²) characters maximum
    
    Optimizations comparison:
    - Without visited array: INFINITE LOOP! (rat goes in circles)
    - With visited but no backtracking: Only finds 1 path
    - With visited + backtracking: Finds ALL paths ✅
    
    ───────────────────────────────────────────────────────────────────────
    
    🎓 KEY LEARNINGS - RAT IN A MAZE:
    
    1. **Visited Tracking**: Essential to prevent infinite loops
    2. **Backtracking for Exploration**: Unmark to allow multiple paths
    3. **Direction Arrays**: Clean, extensible code for multi-directional movement
    4. **Path Building**: Accumulate path string as we explore
    5. **Boundary Validation**: Always check before accessing array elements
    6. **Lexicographic Order**: Process directions in specific order for sorted output
    
    This pattern applies to: Path finding, maze solving, grid traversal,
    shortest path problems, game AI
    
    ═══════════════════════════════════════════════════════════════════════
    */
    
    
    
    /*
    ═══════════════════════════════════════════════════════════════════════
                        UNIVERSAL BACKTRACKING TEMPLATE
    ═══════════════════════════════════════════════════════════════════════
    
    The problems above follow a common backtracking pattern. Here's the 
    universal template you can adapt to ANY backtracking problem:
    
    ```java
    void backtrack(state, choices, result) {
        // BASE CASE: Check if we've reached a valid solution
        if (isValidSolution(state)) {
            result.add(copySolution(state));
            return;
        }
        
        // Try each possible choice
        for (choice in choices) {
            // PRUNE: Skip invalid choices early
            if (!isValid(choice, state)) {
                continue;
            }
            
            // STEP 1: Make the choice (modify state)
            makeChoice(state, choice);
            
            // STEP 2: Explore with this choice (recurse)
            backtrack(state, nextChoices, result);
            
            // STEP 3: Unmake the choice (restore state) - BACKTRACK!
            unmakeChoice(state, choice);
        }
    }
    ```
    
    Mapping to our problems:
    
    WORD SEARCH:
    - State: current position (row, col), word index
    - Choices: 4 directions (up, down, left, right)
    - Make choice: Mark cell visited, move to new cell
    - Unmake choice: Unmark cell
    
    N-QUEEN:
    - State: which rows have queens, current row being filled
    - Choices: columns in current row
    - Make choice: Place queen, mark column/diagonals as attacked
    - Unmake choice: Remove queen, unmark column/diagonals
    
    RAT IN MAZE:
    - State: current position, path string
    - Choices: 4 directions (D, L, R, U)
    - Make choice: Mark visited, move to new cell, append direction to path
    - Unmake choice: Unmark visited
    
    ═══════════════════════════════════════════════════════════════════════
    */
    
    
    
