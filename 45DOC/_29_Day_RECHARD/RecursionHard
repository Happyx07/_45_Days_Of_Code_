    /*
    ═══════════════════════════════════════════════════════════════════════
                            PROBLEM 1: WORD SEARCH
    ═══════════════════════════════════════════════════════════════════════
    
    🎯 PROBLEM STATEMENT:
    Given a 2D grid of characters and a word, find if the word exists in 
    the grid. The word can be constructed from letters of sequentially 
    adjacent cells (horizontally or vertically). The same cell cannot be 
    used more than once.
    
    📝 REAL-WORLD ANALOGY:
    Imagine you're playing a word puzzle game where you need to trace a 
    word on a letter board. You can move up, down, left, or right to the 
    next letter, but you can't step on the same tile twice!
    
    Example:
    Grid:
    A B C E
    S F C S
    A D E E
    
    Word: "ABCCED" → TRUE (A→B→C→C→E→D path exists)
    Word: "SEE" → TRUE (S→E→E path exists)
    Word: "ABCB" → FALSE (Can't reuse B)
    
    ───────────────────────────────────────────────────────────────────────
    
    🤔 NAIVE APPROACH (Brute Force Thinking):
    
    The simplest thought process:
    1. "I need to find where the word starts in the grid"
    2. "From each starting position, I'll try to match the word letter by letter"
    3. "At each step, I can move in 4 directions: up, down, left, right"
    4. "If I get stuck, I need to go back and try a different path"
    
    This is the ESSENCE of backtracking!
    
    ───────────────────────────────────────────────────────────────────────
    
    📊 DRY RUN - Let's trace "SEE" in the grid:
    
    Grid:                  Step-by-step exploration:
    A B C E                
    S F C S                1. Start at S(1,0)
    A D E E                2. Look for 'E' around S → found at E(2,2)
                          3. Look for 'E' around E(2,2) → found at E(2,3)
                          4. Word complete! Return TRUE
    
    What if we tried a wrong path?
    1. Start at S(1,3)
    2. Look for 'E' around S(1,3) → found at E(0,3)
    3. Look for 'E' around E(0,3) → NOT found in valid neighbors
    4. BACKTRACK to S(1,3), try different direction
    5. Eventually find the correct path or exhaust all options
    
    ───────────────────────────────────────────────────────────────────────
    
    🌳 RECURSIVE TREE VISUALIZATION:
    
    For word "SEE" starting from S at (1,0):
    
                        S(1,0) [index=0]
                            |
                    Try 4 directions
                    /   |   |   \
                  ❌   ❌   E(2,2) ❌
                            [index=1]
                                |
                        Try 4 directions
                        /   |   |   \
                      ❌   ❌   E(2,3) ❌
                                [index=2]
                                    |
                              Word Complete! ✅
    
    ❌ = Invalid move (out of bounds, wrong letter, or already visited)
    
    ───────────────────────────────────────────────────────────────────────
    
    🔄 BACKTRACKING CONCEPT:
    
    Key Insight: We need to MARK cells as VISITED when exploring, then 
    UNMARK them when backtracking to allow other paths to use them.
    
    The Backtracking Pattern:
    1. Make a choice (move to a cell)
    2. Mark it as visited
    3. Explore further (recursive call)
    4. Unmake the choice (unmark as visited) ← This is BACKTRACKING!
    
    Why backtrack?
    - If we don't unmark, other potential paths can't use that cell
    - We need to restore the state before trying a different path
    
    ───────────────────────────────────────────────────────────────────────
    
    ⚡ OPTIMIZATIONS:
    
    1. Early Termination: If we find the word, stop searching
    2. Boundary Checks: Validate indices before accessing grid
    3. Visited Marking: Use the grid itself (modify and restore) instead 
       of extra visited array
    4. Direction Array: Use arrays for cleaner 4-direction exploration
    
    ───────────────────────────────────────────────────────────────────────
    */
    
    // ==================== SOLUTION 1: WORD SEARCH ====================
    
    /**
     * Main function to check if word exists in grid
     * Time: O(N * M * 4^L) where N=rows, M=cols, L=word length
     * Space: O(L) for recursion stack
     */
    public static boolean wordSearch(char[][] board, String word) {
        if (board == null || board.length == 0 || word == null) {
            return false;
        }
        
        int rows = board.length;
        int cols = board[0].length;
        
        // Try starting from each cell in the grid
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                // If first letter matches, start DFS from this cell
                if (board[i][j] == word.charAt(0)) {
                    if (dfsWordSearch(board, word, i, j, 0)) {
                        return true;
                    }
                }
            }
        }
        return false;
    }
    
    /**
     * DFS helper function - explores all 4 directions recursively
     * 
     * @param board - 2D character grid
     * @param word - target word to search
     * @param row - current row position
     * @param col - current column position
     * @param index - current index in the word we're matching
     * @return true if word can be formed from this position
     */
    private static boolean dfsWordSearch(char[][] board, String word, 
                                         int row, int col, int index) {
        
        // BASE CASE 1: We've matched all characters! SUCCESS! 🎉
        if (index == word.length()) {
            return true;
        }
        
        // BASE CASE 2: Out of bounds or wrong character
        if (row < 0 || row >= board.length || 
            col < 0 || col >= board[0].length || 
            board[row][col] != word.charAt(index)) {
            return false;
        }
        
        // STEP 1: Mark current cell as visited by temporarily changing it
        char temp = board[row][col];
        board[row][col] = '#';  // Mark as visited
        
        // STEP 2: Explore all 4 directions (up, down, left, right)
        boolean found = dfsWordSearch(board, word, row - 1, col, index + 1) ||  // UP
                       dfsWordSearch(board, word, row + 1, col, index + 1) ||  // DOWN
                       dfsWordSearch(board, word, row, col - 1, index + 1) ||  // LEFT
                       dfsWordSearch(board, word, row, col + 1, index + 1);    // RIGHT
        
        // STEP 3: BACKTRACK - Restore the cell (unmake the choice)
        board[row][col] = temp;  // This is the KEY backtracking step!
        
        return found;
    }
    
    // Alternative cleaner version using direction arrays
    private static int[] dx = {-1, 1, 0, 0};  // Row directions: up, down, left, right
    private static int[] dy = {0, 0, -1, 1};  // Col directions: up, down, left, right
    
    private static boolean dfsWordSearchClean(char[][] board, String word, 
                                              int row, int col, int index) {
        // Base cases
        if (index == word.length()) return true;
        if (row < 0 || row >= board.length || col < 0 || col >= board[0].length) {
            return false;
        }
        if (board[row][col] != word.charAt(index)) return false;
        
        // Mark visited
        char temp = board[row][col];
        board[row][col] = '#';
        
        // Try all 4 directions
        for (int dir = 0; dir < 4; dir++) {
            int newRow = row + dx[dir];
            int newCol = col + dy[dir];
            if (dfsWordSearchClean(board, word, newRow, newCol, index + 1)) {
                board[row][col] = temp;  // Restore before returning
                return true;
            }
        }
        
        // Backtrack
        board[row][col] = temp;
        return false;
    }
    
    /*
    ───────────────────────────────────────────────────────────────────────
    
    📈 COMPLEXITY ANALYSIS - WORD SEARCH:
    
    Time Complexity: O(N × M × 4^L)
    - N × M: We might start from any cell in the grid
    - 4^L: At each step, we have 4 choices, and we go L levels deep
    - In practice, it's much better due to pruning (invalid moves)
    
    Space Complexity: O(L)
    - Recursion stack depth = word length
    - We modify the grid in-place for visited marking
    
    Comparison:
    - Brute Force (generate all paths): O(N × M × 4^(N×M)) - TERRIBLE!
    - Our approach with backtracking: O(N × M × 4^L) - MUCH BETTER!
    - Early termination and pruning make it even faster in practice
    
    ───────────────────────────────────────────────────────────────────────
    
    🎓 KEY LEARNINGS - WORD SEARCH:
    
    1. **Backtracking Pattern**: Make choice → Explore → Unmake choice
    2. **State Restoration**: Always restore modified state when backtracking
    3. **In-place Marking**: Clever trick to avoid extra visited array
    4. **Direction Arrays**: Clean way to handle 4/8 direction movements
    5. **Early Termination**: Return immediately when solution is found
    
    This pattern applies to: Grid traversal, path finding, maze problems
    
    ═══════════════════════════════════════════════════════════════════════
    */
    
    
    
    /*
    ═══════════════════════════════════════════════════════════════════════
                          PROBLEM 2: N-QUEEN PROBLEM
    ═══════════════════════════════════════════════════════════════════════
    
    🎯 PROBLEM STATEMENT:
    Place N queens on an N×N chessboard such that no two queens attack 
    each other. A queen can attack horizontally, vertically, and diagonally.
    Find all possible solutions.
    
    📝 REAL-WORLD ANALOGY:
    Imagine you're organizing a party with N very competitive people in an 
    N×N seating arrangement. Each person doesn't want to sit in the same 
    row, column, or diagonal as any other person. How many seating 
    arrangements are possible?
    
    Example: N = 4
    
    Solution 1:        Solution 2:
    . Q . .            . . Q .
    . . . Q            Q . . .
    Q . . .            . . . Q
    . . Q .            . Q . .
    
    (There are 2 solutions for N=4)
    
    ───────────────────────────────────────────────────────────────────────
    
    🤔 NAIVE APPROACH (Brute Force Thinking):
    
    Initial thought process:
    1. "I need to place N queens on N×N board"
    2. "I'll try placing a queen in every possible position"
    3. "For each placement, check if it's safe (no attacks)"
    4. "If I can place all N queens, that's a solution"
    5. "If I get stuck, remove the last queen and try a different position"
    
    Key Insight: We can place ONE queen per ROW! This reduces our search space.
    Instead of trying all N² positions, we try N positions per row.
    
    ───────────────────────────────────────────────────────────────────────
    
    📊 DRY RUN - Let's solve for N=4:
    
    Row 0: Try placing queen at each column
    
    Attempt 1: Place at (0,0)
    Board:              Can we continue?
    Q . . .             Row 1: Can't place at (1,0) or (1,1) → Try (1,2)
    . . Q .             Row 2: Can't place anywhere! BACKTRACK
    . . . .
    . . . .
    
    Attempt 2: Place at (0,1)
    Board:              Can we continue?
    . Q . .             Row 1: Can't place at (1,0), (1,1), (1,2) → Try (1,3)
    . . . Q             Row 2: Try (2,0) → No safe place for Row 3. BACKTRACK
    . . . .             Try (2,1) → Can place at (3,2). SUCCESS! ✅
    . . . .
    
    ───────────────────────────────────────────────────────────────────────
    
    🌳 RECURSIVE TREE VISUALIZATION (N=4):
    
                            Start (Row 0)
                        /    |    |    \
                    Col0  Col1  Col2  Col3
                    /      |      |      \
               Row1      Row1   Row1    Row1
              / | \      /|\     ...     ...
            ...  ... (continue exploring each valid placement)
    
    At each level (row), we try placing queen at each column.
    We only go deeper if the placement is SAFE.
    If we reach Row N, we found a solution!
    
    ───────────────────────────────────────────────────────────────────────
    
    🔄 BACKTRACKING CONCEPT:
    
    The N-Queen backtracking process:
    
    1. Choose a column in the current row
    2. Check if it's safe (no queen attacks)
    3. Place the queen (make the choice)
    4. Move to next row (recurse)
    5. If next row fails, REMOVE the queen (unmake choice) ← BACKTRACK
    6. Try next column in current row
    
    Why backtrack?
    - A placement might seem fine initially but lead to dead end later
    - We need to try ALL possibilities systematically
    - Backtracking lets us explore different branches of the decision tree
    
    Attack Detection:
    A queen at (row, col) attacks:
    - Same row: Any (row, *) - We avoid by placing 1 queen per row
    - Same column: Any (*, col) - Check column before placing
    - Main diagonal: Any (r, c) where r - c == row - col
    - Anti-diagonal: Any (r, c) where r + c == row + col
    
    ───────────────────────────────────────────────────────────────────────
    
    ⚡ OPTIMIZATIONS:
    
    1. **One Queen Per Row**: Only try different columns for each row
    2. **Fast Attack Checking**: Use sets/arrays to track attacked diagonals
    3. **Pruning**: Don't explore subtrees that violate constraints
    4. **Symmetry Breaking**: Can optimize further using board symmetries
    
    Instead of checking entire board each time (O(N²)), we use:
    - colSet: Track occupied columns
    - diagSet: Track occupied main diagonals (row - col)
    - antiDiagSet: Track occupied anti-diagonals (row + col)
    
    This makes conflict checking O(1)!
    
    ───────────────────────────────────────────────────────────────────────
    */
    
    // ==================== SOLUTION 2: N-QUEEN ====================
    
    /**
     * Brute Force Version - Easy to understand but slower
     * Checks entire board for conflicts each time
     */
    public static List<List<String>> solveNQueensBruteForce(int n) {
        List<List<String>> solutions = new ArrayList<>();
        char[][] board = new char[n][n];
        
        // Initialize board with empty cells
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                board[i][j] = '.';
            }
        }
        
        backtrackNQueenBrute(solutions, board, 0);
        return solutions;
    }
    
    private static void backtrackNQueenBrute(List<List<String>> solutions, 
                                             char[][] board, int row) {
        // BASE CASE: All queens placed successfully!
        if (row == board.length) {
            solutions.add(constructSolution(board));
            return;
        }
        
        // Try placing queen in each column of current row
        for (int col = 0; col < board.length; col++) {
            if (isSafeBrute(board, row, col)) {
                // STEP 1: Make the choice (place queen)
                board[row][col] = 'Q';
                
                // STEP 2: Explore (recurse to next row)
                backtrackNQueenBrute(solutions, board, row + 1);
                
                // STEP 3: Unmake the choice (remove queen) - BACKTRACK!
                board[row][col] = '.';
            }
        }
    }
    
    /**
     * Check if placing queen at (row, col) is safe
     * This is O(N) check for each placement
     */
    private static boolean isSafeBrute(char[][] board, int row, int col) {
        int n = board.length;
        
        // Check column (no queen above in same column)
        for (int i = 0; i < row; i++) {
            if (board[i][col] == 'Q') return false;
        }
        
        // Check main diagonal (top-left to bottom-right)
        for (int i = row - 1, j = col - 1; i >= 0 && j >= 0; i--, j--) {
            if (board[i][j] == 'Q') return false;
        }
        
        // Check anti-diagonal (top-right to bottom-left)
        for (int i = row - 1, j = col + 1; i >= 0 && j < n; i--, j++) {
            if (board[i][j] == 'Q') return false;
        }
        
        return true;
    }
    
    /**
     * OPTIMIZED VERSION - Uses sets for O(1) conflict checking
     * This is the RECOMMENDED approach!
     */
    public static List<List<String>> solveNQueens(int n) {
        List<List<String>> solutions = new ArrayList<>();
        char[][] board = new char[n][n];
        
        // Initialize board
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                board[i][j] = '.';
            }
        }
        
        // Sets for O(1) conflict checking
        Set<Integer> columns = new HashSet<>();
        Set<Integer> diagonals = new HashSet<>();      // row - col
        Set<Integer> antiDiagonals = new HashSet<>();  // row + col
        
        backtrackNQueen(solutions, board, 0, columns, diagonals, antiDiagonals);
        return solutions;
    }
    
    private static void backtrackNQueen(List<List<String>> solutions, 
                                       char[][] board, int row,
                                       Set<Integer> columns, 
                                       Set<Integer> diagonals,
                                       Set<Integer> antiDiagonals) {
        int n = board.length;
        
        // BASE CASE: All queens placed!
        if (row == n) {
            solutions.add(constructSolution(board));
            return;
        }
        
        // Try placing queen at each column in current row
        for (int col = 0; col < n; col++) {
            int diag = row - col;
            int antiDiag = row + col;
            
            // Check if this position is under attack (O(1) check!)
            if (columns.contains(col) || 
                diagonals.contains(diag) || 
                antiDiagonals.contains(antiDiag)) {
                continue;  // Skip this column, it's not safe
            }
            
            // STEP 1: Make the choice
            board[row][col] = 'Q';
            columns.add(col);
            diagonals.add(diag);
            antiDiagonals.add(antiDi
            ag);
            
            // STEP 2: Explore (recurse)
            backtrackNQueen(solutions, board, row + 1, 
                          columns, diagonals, antiDiagonals);
            
            // STEP 3: Unmake the choice - BACKTRACK!
            board[row][col] = '.';
            columns.remove(col);
            diagonals.remove(diag);
            antiDiagonals.remove(antiDiag);
        }
    }
    
    /**
     * Convert board to required output format
     */
    private static List<String> constructSolution(char[][] board) {
        List<String> solution = new ArrayList<>();
        for (char[] row : board) {
            solution.add(new String(row));
        }
        return solution;
    }
    
