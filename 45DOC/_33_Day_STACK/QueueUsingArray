class QueueUsingStacks {
    private java.util.Stack<Integer> stack1;  // For enqueue
    private java.util.Stack<Integer> stack2;  // For dequeue
    
    public QueueUsingStacks() {
        stack1 = new java.util.Stack<>();
        stack2 = new java.util.Stack<>();
    }
    
    /**
     * ENQUEUE - O(1)
     * Simply push to stack1
     */
    public void enqueue(int x) {
        stack1.push(x);
    }
    
    /**
     * DEQUEUE - Amortized O(1)
     * Transfer from stack1 to stack2 when stack2 is empty
     */
    public int dequeue() {
        if (stack2.isEmpty()) {
            // Transfer all elements from stack1 to stack2
            while (!stack1.isEmpty()) {
                stack2.push(stack1.pop());
            }
        }
        
        if (stack2.isEmpty()) {
            System.out.println("Queue is empty!");
            return -1;
        }
        
        return stack2.pop();
    }
    
    public boolean isEmpty() {
        return stack1.isEmpty() && stack2.isEmpty();
    }
}

/*
Time Complexity:
- enqueue: O(1)
- dequeue: Amortized O(1) (occasionally O(n) but averages to O(1))

🔹 PROBLEM 2: IMPLEMENT STACK USING QUEUES
───────────────────────────────────────────────────────────────────────────

Problem: Implement stack using two queues
Approach: Make push operation costly OR make pop operation costly

*/

class StackUsingQueues {
    private java.util.Queue<Integer> q1;
    private java.util.Queue<Integer> q2;
    
    public StackUsingQueues() {
        q1 = new java.util.LinkedList<>();
        q2 = new java.util.LinkedList<>();
    }
    
    /**
     * PUSH - O(n)
     * Add to q2, transfer q1 to q2, swap queues
     */
    public void push(int x) {
        // Add new element to q2
        q2.add(x);
        
        // Transfer all elements from q1 to q2
        while (!q1.isEmpty()) {
            q2.add(q1.remove());
        }
        
        // Swap q1 and q2
        java.util.Queue<Integer> temp = q1;
        q1 = q2;
        q2 = temp;
    }
    
    /**
     * POP - O(1)
     * Simply remove from q1
     */
    public int pop() {
        if (q1.isEmpty()) {
            System.out.println("Stack is empty!");
            return -1;
        }
        return q1.remove();
    }
    
    public boolean isEmpty() {
        return q1.isEmpty();
    }
}

/*
Time Complexity:
- push: O(n)
- pop: O(1)

🔹 PROBLEM 3: REVERSE A QUEUE
───────────────────────────────────────────────────────────────────────────

Problem: Reverse the elements of a queue
Approach 1: Using stack
Approach 2: Using recursion

*/

class ReverseQueue {
    // Method 1: Using Stack - O(n) time, O(n) space
    public static void reverseUsingStack(java.util.Queue<Integer> queue) {
        java.util.Stack<Integer> stack = new java.util.Stack<>();
        
        // Dequeue all elements and push to stack
        while (!queue.isEmpty()) {
            stack.push(queue.remove());
        }
        
        // Pop from stack and enqueue back to queue
        while (!stack.isEmpty()) {
            queue.add(stack.pop());
        }
    }
    
    // Method 2: Using Recursion - O(n) time, O(n) space
    public static void reverseUsingRecursion(java.util.Queue<Integer> queue) {
        if (queue.isEmpty()) {
            return;
        }
        
        // Remove front element
        int front = queue.remove();
        
        // Reverse the remaining queue
        reverseUsingRecursion(queue);
        
        // Add the removed element to the back
        queue.add(front);
    }
}

/*
🔹 PROBLEM 4: FIRST NON-REPEATING CHARACTER IN A STREAM
───────────────────────────────────────────────────────────────────────────

Problem: Given a stream of characters, find first non-repeating character
Example: Stream: "aabcddbe" → Output at each step: a, -1, b, b, b, b, b, e

Approach: Use queue + frequency map

