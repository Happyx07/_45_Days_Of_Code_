class MyQueue {
    private Stack<Integer> input;   // For enqueue
    private Stack<Integer> output;  // For dequeue
    
    /**
     * Initialize your data structure here.
     */
    public MyQueue() {
        input = new Stack<>();
        output = new Stack<>();
    }
    
    /**
     * Push element x to the back of queue.
     * Time Complexity: O(1)
     */
    public void push(int x) {
        input.push(x);
    }
    
    /**
     * Removes the element from front of queue and returns that element.
     * Time Complexity: Amortized O(1)
     */
    public int pop() {
        // Transfer from input to output if output is empty
        if (output.isEmpty()) {
            while (!input.isEmpty()) {
                output.push(input.pop());
            }
        }
        return output.pop();
    }
    
    /**
     * Get the front element.
     * Time Complexity: Amortized O(1)
     */
    public int peek() {
        // Transfer from input to output if output is empty
        if (output.isEmpty()) {
            while (!input.isEmpty()) {
                output.push(input.pop());
            }
        }
        return output.peek();
    }
    
    /**
     * Returns whether the queue is empty.
     * Time Complexity: O(1)
     */
    public boolean empty() {
        return input.isEmpty() && output.isEmpty();
    }
}

