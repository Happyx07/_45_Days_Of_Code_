import java.util.Stack;

class QueueUsingTwoStacks_EnqueueCostly {
    private Stack<Integer> stack1;  // Main stack (maintains queue order)
    private Stack<Integer> stack2;  // Helper stack (temporary during enqueue)
    
    /**
     * Constructor - Initialize both stacks
     */
    public QueueUsingTwoStacks_EnqueueCostly() {
        stack1 = new Stack<>();
        stack2 = new Stack<>();
    }
    
    /**
     * ENQUEUE OPERATION - Add element to queue (rear)
     * Time Complexity: O(n) where n = number of elements
     * Space Complexity: O(1) auxiliary
     * 
     * Strategy: Transfer all to stack2, push new, transfer back
     */
    public void enqueue(int x) {
        // Step 1: Move all elements from stack1 to stack2
        while (!stack1.isEmpty()) {
            stack2.push(stack1.pop());
        }
        
        // Step 2: Push new element to stack1
        stack1.push(x);
        
        // Step 3: Move all elements back from stack2 to stack1
        while (!stack2.isEmpty()) {
            stack1.push(stack2.pop());
        }
        
        System.out.println(x + " enqueued to queue");
    }
    
    /**
     * DEQUEUE OPERATION - Remove and return front element
     * Time Complexity: O(1)
     * Space Complexity: O(1)
     */
    public int dequeue() {
        if (stack1.isEmpty()) {
            System.out.println("Queue Underflow!");
            return -1;
        }
        
        return stack1.pop();
    }
    
    /**
     * FRONT/PEEK OPERATION - Return front element without removing
     * Time Complexity: O(1)
     * Space Complexity: O(1)
     */
    public int front() {
        if (stack1.isEmpty()) {
            System.out.println("Queue is empty!");
            return -1;
        }
        
        return stack1.peek();
    }
    
    /**
     * CHECK IF EMPTY
     * Time Complexity: O(1)
     */
    public boolean empty() {
        return stack1.isEmpty();
    }
    
    /**
     * GET SIZE
     * Time Complexity: O(1)
     */
    public int size() {
        return stack1.size();
    }
}

