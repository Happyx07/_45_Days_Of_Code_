         APPROACH 2 - JAVA IMPLEMENTATION (DEQUEUE COSTLY) ⭐⭐⭐
═══════════════════════════════════════════════════════════════════════════
*/

class QueueUsingTwoStacks_DequeueCostly {
    private Stack<Integer> stack1;  // Input stack (for enqueue)
    private Stack<Integer> stack2;  // Output stack (for dequeue)
    
    /**
     * Constructor - Initialize both stacks
     */
    public QueueUsingTwoStacks_DequeueCostly() {
        stack1 = new Stack<>();
        stack2 = new Stack<>();
    }
    
    /**
     * ENQUEUE OPERATION - Add element to queue
     * Time Complexity: O(1) - Simply push to stack1
     * Space Complexity: O(1)
     * 
     * Strategy: Always push to stack1 (input stack)
     */
    public void enqueue(int x) {
        stack1.push(x);
        System.out.println(x + " enqueued to queue");
    }
    
    /**
     * DEQUEUE OPERATION - Remove and return front element
     * Time Complexity: Amortized O(1)
     *   - Best Case: O(1) when stack2 has elements
     *   - Worst Case: O(n) when need to transfer
     *   - Amortized: O(1) because each element transfers once
     * Space Complexity: O(1)
     * 
     * Strategy: Use stack2 as output. Transfer only when stack2 is empty.
     */
    public int dequeue() {
        // If both stacks are empty, queue is empty
        if (stack1.isEmpty() && stack2.isEmpty()) {
            System.out.println("Queue Underflow!");
            return -1;
        }
        
        // If stack2 is empty, transfer all from stack1
        if (stack2.isEmpty()) {
            while (!stack1.isEmpty()) {
                stack2.push(stack1.pop());
            }
        }
        
        // Pop from stack2 (has elements in queue order)
        return stack2.pop();
    }
    
    /**
     * FRONT/PEEK OPERATION - Return front without removing
     * Time Complexity: Amortized O(1)
     * Space Complexity: O(1)
     */
    public int front() {
        if (stack1.isEmpty() && stack2.isEmpty()) {
            System.out.println("Queue is empty!");
            return -1;
        }
        
        // If stack2 is empty, transfer from stack1
        if (stack2.isEmpty()) {
            while (!stack1.isEmpty()) {
                stack2.push(stack1.pop());
            }
        }
        
        // Peek from stack2
        return stack2.peek();
    }
    
    /**
     * CHECK IF EMPTY
     * Time Complexity: O(1)
     */
    public boolean empty() {
        return stack1.isEmpty() && stack2.isEmpty();
    }
    
    /**
     * GET SIZE
     * Time Complexity: O(1)
     */
    public int size() {
        return stack1.size() + stack2.size();
    }
}

