🔹 PROBLEM 1: REVERSE A STRING USING STACK
───────────────────────────────────────────────────────────────────────────

Problem: Given a string, reverse it using stack.
Approach: Push all characters, then pop them (LIFO reverses the order)

*/

class StringReversal {
    public static String reverseString(String str) {
        // Create stack with string length as capacity
        StackUsingArray stack = new StackUsingArray(str.length());
        
        // Push all characters onto stack
        for (int i = 0; i < str.length(); i++) {
            stack.push(str.charAt(i));
        }
        
        // Pop all characters to get reversed string
        StringBuilder reversed = new StringBuilder();
        while (!stack.isEmpty()) {
            reversed.append((char) stack.pop());
        }
        
        return reversed.toString();
    }
    
    public static void main(String[] args) {
        String original = "HELLO";
        String reversed = reverseString(original);
        System.out.println("Original: " + original);
        System.out.println("Reversed: " + reversed);
        // Output: OLLEH
    }
}

/*
Time Complexity: O(n) - Push n characters + Pop n characters
Space Complexity: O(n) - Stack stores n characters

🔹 PROBLEM 2: CHECK BALANCED PARENTHESES
───────────────────────────────────────────────────────────────────────────

Problem: Check if parentheses are balanced in an expression
Examples: 
  "(()())" → Balanced
  "(()" → Not balanced
  "())(" → Not balanced

Approach:
1. Push opening brackets onto stack
2. For closing bracket, check if it matches top of stack
3. Stack should be empty at end for balanced expression

*/

class BalancedParentheses {
    public static boolean isBalanced(String expr) {
        StackUsingArray stack = new StackUsingArray(expr.length());
        
        for (int i = 0; i < expr.length(); i++) {
            char ch = expr.charAt(i);
            
            // Push opening brackets
            if (ch == '(' || ch == '{' || ch == '[') {
                stack.push(ch);
            }
            // Check closing brackets
            else if (ch == ')' || ch == '}' || ch == ']') {
                if (stack.isEmpty()) {
                    return false;  // No matching opening bracket
                }
                
                char top = (char) stack.pop();
                
                // Check if brackets match
                if ((ch == ')' && top != '(') ||
                    (ch == '}' && top != '{') ||
                    (ch == ']' && top != '[')) {
                    return false;
                }
            }
        }
        
        // Stack should be empty for balanced expression
        return stack.isEmpty();
    }
    
    public static void main(String[] args) {
        String[] testCases = {
            "(()())",     // Balanced
            "(()",        // Not balanced
            "{[()]}",     // Balanced
            "{[(])}",     // Not balanced
            "((()))"      // Balanced
        };
        
        for (String test : testCases) {
            System.out.println(test + " → " + 
                (isBalanced(test) ? "Balanced" : "Not Balanced"));
        }
    }
}

/*
Time Complexity: O(n) - Single pass through string
Space Complexity: O(n) - Worst case all opening brackets

🔹 PROBLEM 3: NEXT GREATER ELEMENT
───────────────────────────────────────────────────────────────────────────

Problem: For each element in array, find the next greater element
Example: [4, 5, 2, 10, 8] → [5, 10, 10, -1, -1]

Approach: Use stack to keep track of elements waiting for next greater

*/

class NextGreaterElement {
    public static int[] nextGreater(int[] arr) {
        int n = arr.length;
        int[] result = new int[n];
        StackUsingArray stack = new StackUsingArray(n);
        
        // Traverse from right to left
        for (int i = n - 1; i >= 0; i--) {
            // Pop elements smaller than or equal to current
            while (!stack.isEmpty() && stack.peek() <= arr[i]) {
                stack.pop();
            }
            
            // If stack empty, no greater element
            result[i] = stack.isEmpty() ? -1 : stack.peek();
            
            // Push current element for future comparisons
            stack.push(arr[i]);
        }
        
        return result;
    }
    
    public static void main(String[] args) {
        int[] arr = {4, 5, 2, 10, 8};
        int[] result = nextGreater(arr);
        
        System.out.print("Array: ");
        for (int num : arr) System.out.print(num + " ");
        
        System.out.print("\nNext Greater: ");
        for (int num : result) System.out.print(num + " ");
        // Output: 5 10 10 -1 -1
    }
}

/*
Time Complexity: O(n) - Each element pushed and popped once
Space Complexity: O(n) - Stack space

🔹 PROBLEM 4: IMPLEMENT MIN STACK
───────────────────────────────────────────────────────────────────────────

Problem: Design a stack that supports push, pop, top, and retrieving 
         minimum element in O(1) time.

Approach: Use two stacks - one for data, one for tracking minimum

*/

class MinStack {
    private StackUsingArray dataStack;
    private StackUsingArray minStack;
    
    public MinStack(int capacity) {
        dataStack = new StackUsingArray(capacity);
        minStack = new StackUsingArray(capacity);
    }
    
    public void push(int val) {
        dataStack.push(val);
        
        // Push to minStack if it's minimum so far
        if (minStack.isEmpty() || val <= minStack.peek()) {
            minStack.push(val);
        }
    }
    
    public int pop() {
        if (dataStack.isEmpty()) {
            return -1;
        }
        
        int popped = dataStack.pop();
        
        // If popped element is minimum, pop from minStack too
        if (popped == minStack.peek()) {
            minStack.pop();
        }
        
        return popped;
    }
    
    public int top() {
        return dataStack.peek();
    }
    
    public int getMin() {
        if (minStack.isEmpty()) {
            return -1;
        }
        return minStack.peek();
    }
    
    public static void main(String[] args) {
        MinStack stack = new MinStack(10);
        
        stack.push(5);
        stack.push(2);
        stack.push(7);
        stack.push(1);
        
        System.out.println("Minimum: " + stack.getMin());  // 1
        stack.pop();
        System.out.println("Minimum: " + stack.getMin());  // 2
        stack.pop();
        System.out.println("Minimum: " + stack.getMin());  // 2
    }
}

