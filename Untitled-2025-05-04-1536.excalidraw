      "groupIds": [],
      "frameId": null,
      "index": "bPe",
      "roundness": null,
      "seed": 1183109961,
      "version": 680,
      "versionNonce": 315050887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757960008918,
      "link": null,
      "locked": false,
      "text": "public static int findFirst(int[] nums, int target){\n       int low  = 0;\n        int high = nums.length-1;\n        int first = -1;\n\n        while(low<=high){\n            int mid  = low+(high-low)/2;\n\n            if(nums[mid]==target){\n                        first = mid; \n                         high = mid-1;   \n                    \n                }else if(nums[mid] > target){\n                        low = mid+1;\n        }\n\n\n}",
      "fontSize": 154.3121337184015,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static int findFirst(int[] nums, int target){\n       int low  = 0;\n        int high = nums.length-1;\n        int first = -1;\n\n        while(low<=high){\n            int mid  = low+(high-low)/2;\n\n            if(nums[mid]==target){\n                        first = mid; \n                         high = mid-1;   \n                    \n                }else if(nums[mid] > target){\n                        low = mid+1;\n        }\n\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
