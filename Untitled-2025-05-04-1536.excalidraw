      "link": null,
      "locked": false,
      "text": "public static int  findLast(int[] nums, int target){\n       int low  = 0;\n        int high = nums.length-1;\n        int last = -1;\n\n        while(low<=high){\n            int mid  = low+(high-low)/2;\n\n            if(nums[mid]==target){\n                        last = mid; \n                         low = mid+1;   \n                    \n                }\n        }\n\n\n}",
      "fontSize": 154.3121337184015,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static int  findLast(int[] nums, int target){\n       int low  = 0;\n        int high = nums.length-1;\n        int last = -1;\n\n        while(low<=high){\n            int mid  = low+(high-low)/2;\n\n            if(nums[mid]==target){\n                        last = mid; \n                         low = mid+1;   \n                    \n                }\n        }\n\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
