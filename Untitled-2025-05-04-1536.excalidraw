    {
      "id": "lvm4FNvVKlERC5phenLlr",
      "type": "text",
      "x": 13248.589222986733,
      "y": 37047.558454610036,
      "width": 1385.3878173828125,
      "height": 1305,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbc",
      "roundness": null,
      "seed": 1536593552,
      "version": 600,
      "versionNonce": 380654192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758220953563,
      "link": null,
      "locked": false,
      "text": "public boolean  isPossible(int[] bloomDay, int day, int m, int k){\n\nint bqtMade = 0;\nint adjFlower = 0;            // when this become == k we will increment bqtMade\n\nfor(int bDay : bloodDay){\n\n        if(bDay <= day){\n          \n        adjFlower++;\n        }else{\n\n        adjFlowers = 0;\n        }\n   \n      if(adjFlower == k){\n        \n         bqtMade++;\n         adjFlowers = 0;\n     }\n}\n\nreturn bqtMade >= m;\n\n}\n    \n\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public boolean  isPossible(int[] bloomDay, int day, int m, int k){\n\nint bqtMade = 0;\nint adjFlower = 0;            // when this become == k we will increment bqtMade\n\nfor(int bDay : bloodDay){\n\n        if(bDay <= day){\n          \n        adjFlower++;\n        }else{\n\n        adjFlowers = 0;\n        }\n   \n      if(adjFlower == k){\n        \n         bqtMade++;\n         adjFlowers = 0;\n     }\n}\n\nreturn bqtMade >= m;\n\n}\n    \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
