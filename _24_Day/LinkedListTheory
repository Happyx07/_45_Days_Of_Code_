// Method 1: Find second-to-last node
public int findSecondLast() {
    if (head == null || head.next == null) {
        return -1;  // Less than 2 nodes
    }
    
    Node current = head;
    while (current.next.next != null) {
        current = current.next;
    }
    return current.data;
}

// Method 2: Count even numbers
public int countEven() {
    int count = 0;
    Node current = head;
    
    while (current != null) {
        if (current.data % 2 == 0) {
            count++;
        }
        current = current.next;
    }
    return count;
}

// Method 3: Get element at specific index
public int getAt(int index) {
    if (index < 0) {
        return -1;  // Invalid index
    }
    
    Node current = head;
    int currentIndex = 0;
    
    while (current != null) {
        if (currentIndex == index) {
            return current.data;
        }
        current = current.next;
        currentIndex++;
    }
    return -1;  // Index out of bounds
}

// Method 4: Print in reverse using recursion
public void printReverse() {
    printReverseHelper(head);
    System.out.println();
}

private void printReverseHelper(Node node) {
    if (node == null) {
        return;  // Base case
    }
    
    printReverseHelper(node.next);  // Recursive call
    System.out.print(node.data + " ");  // Print after recursion
}
```

